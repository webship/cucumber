<?php

/**
 * @file
 * Install, update and uninstall functions for the Cucumber installer.
 */

/**
 * Implements hook_install().
 *
 * The site configuration is owned by the chosen site template, so there is
 * nothing to do here beyond rebuilding the caches once the profile module is
 * installed.
 *
 * @see \Drupal\cucumber\Form\SiteTemplateForm
 */
function cucumber_install(): void {
  drupal_flush_all_caches();
}
