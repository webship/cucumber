{
  "name": "cucumber",
  "private": true,
  "description": "Cucumber Automated Functional Acceptance Testing Management system",
  "license": "GPL-2.0",
  "engines": {
    "yarn": ">= 4.18.1",
    "node": ">= 24.0"
  },
  "packageManager": "yarn@4.18.1",
  "keywords": [
    "Drupal",
    "Cucumber",
    "Drupal profile",
    "Gherkin",
    "Automated Testing"
  ],
  "author": "Webship.co",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "eslint --ext .yml .",
    "test": "node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:headed": "HEADLESS=false node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js",
    "test:chromium": "BROWSER=chromium node ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.js"
  },
  "devDependencies": {
    "webship-js": "^2.0.6"
  },
  "resolutions": {
    "@cucumber/cucumber": "10.0.1"
  }
}
