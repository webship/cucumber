{
  "css": {
    "modal": ".ui-dialog, [role=\"dialog\"], .dialog-off-canvas-main-canvas",
    "shell": ".uikit-admin-shell",
    "main nav": ".uikit-admin-rail__body",
    "main nav section": ".uikit-admin-rail__section",
    "main nav item": ".uikit-admin-rail__item",
    "site name": ".uikit-admin-rail__site-name",
    "account": ".uikit-admin-rail__account",
    "account name": ".uikit-admin-rail__account-name",
    "account role": ".uikit-admin-rail__account-role",
    "log out link": ".uikit-admin-rail__logout",
    "sidebar toggle": ".uikit-admin-rail__toggle",
    "header bar": ".uikit-admin-header",
    "command palette": ".uikit-admin-palette",
    "command palette search": ".uikit-admin-palette__search",
    "page title": ".uikit-admin-header h1, h1",
    "content area": ".uikit-admin-main",
    "messages": ".uikit-admin-messages, [data-drupal-messages]",
    "sign in": ".uikit-admin-sign-in",
    "sign in card": ".uikit-admin-sign-in__card",
    "sign in form": ".uikit-admin-sign-in__form",
    "save button": "#edit-submit",
    "form": ".uikit-admin-main form",
    "form item": ".uikit-admin-form-item, .form-item",
    "form select": "select",
    "form textarea": "textarea",
    "form actions": ".form-actions",
    "dropbutton": ".uikit-admin-dropbutton, .dropbutton-wrapper",
    "data table": "table",
    "table header": "thead tr",
    "table row": "tbody tr",
    "table first row": "tbody tr:first-child",
    "pager": ".pager, .uk-pagination",
    "dashboard links": ".cucumber-core-action-links",
    "gherkin editor": ".ace_editor",
    "workflow state": "#edit-moderation-state-0-state",
    "current workflow state": "#edit-moderation-state-0-current"
  },
  "xpath": {
    "page main heading": "//h1",
    "main nav first item": "(//*[contains(@class,'uikit-admin-rail__item')])[1]",
    "first table row": "//table//tbody/tr[1]",
    "messages block": "//*[@data-drupal-messages]",
    "save button": "//input[@value='Save'] | //button[normalize-space()='Save']",
    "log out link": "//a[contains(@class,'uikit-admin-rail__logout')]"
  }
}
